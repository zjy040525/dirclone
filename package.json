{
  "name": "dirclone",
  "type": "module",
  "version": "1.0.3",
  "description": "A simple CLI tool to clone a directory from a URL into a specified output directory.",
  "author": "zjy040525 <jiayao.zhao@proton.me>",
  "license": "MIT",
  "homepage": "https://github.com/zjy040525/dirclone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjy040525/dirclone.git"
  },
  "bugs": {
    "url": "https://github.com/zjy040525/dirclone/issues"
  },
  "imports": {
    "#dirclone": "./src/index.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dirclone": "bin/dirclone.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx ./src/cli.ts",
    "schema": "tsx ./scripts/generate-schema.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build && pnpm run schema",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.22.0 <12.0.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "ansis": "catalog:prod",
    "cac": "catalog:prod",
    "cli-progress": "catalog:prod",
    "deepmerge": "catalog:prod",
    "restore-cursor": "catalog:prod",
    "ts-json-schema-generator": "catalog:prod",
    "unconfig": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/cli-progress": "catalog:types",
    "@types/node": "catalog:types",
    "bumpp": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:build",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  }
}
